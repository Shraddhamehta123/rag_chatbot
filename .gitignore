# Secrets -- NEVER commit these
.env

# Python
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# Local data stores generated at runtime (rebuildable from data/pdfs/ via scripts/ingest.py)
vectorstore_db/
mlruns/

# Per-run retrieval evaluation history -- scratch, not meant for review.
# eval_results/latest.json is the exception (see below): it's the one
# snapshot meant to be committed and reviewed, so it's tracked deliberately.
eval_results/*
!eval_results/latest.json

# Archive/snapshot files -- never commit a zip of the project into the
# project; source control already IS the archive, and a checked-in copy
# only goes stale the moment either one changes without the other.
*.zip

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# pytest
.pytest_cache/
